UPSTAGE_API_KEY=up_your_api_key_here

# 사용할 Solar 챗 모델 (기본: solar-pro4)
# UPSTAGE_CHAT_MODEL=solar-pro4

# Upstage Studio에서 만든 에이전트 ID (run_studio_agent 툴 기본값)
# studio.upstage.ai → 에이전트 저장 → Code 패널에서 복사
# UPSTAGE_AGENT_ID=agt_xxxxxxxxxxxxxxxxxxxx

# Supabase (저장소: 공고·프로필·추천 캐시·원본 파일)
# supabase.com 대시보드 → Project Settings → API에서 복사
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
